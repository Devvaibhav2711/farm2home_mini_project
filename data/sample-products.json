  "apiEndpoints": {
    "getAllProducts": {
      "method": "GET",
      "url": "/api/products",
      "queryParams": {
        "categories": "Comma-separated list: Vegetables,Fruits",
        "tags": "Comma-separated: high-vitamin-c,high-protein",
        "maxCalories": "Number (e.g., 100)",
        "minProtein": "Number (e.g., 5)",
        "organicOnly": "true or false",
        "search": "Search text",
        "sort": "price-asc, price-desc, name, calories, protein"
      }
    },
    "getCategories": {
      "method": "GET",
      "url": "/api/products/categories"
    },
    "getTags": {
      "method": "GET",
      "url": "/api/products/tags"
    }
  },
  "databaseSchema": {
    "collectionName": "products",
    "indexes": [
      { "field": "category", "type": "single" },
      { "field": "tags", "type": "single" },
      { "field": "isOrganic", "type": "single" },
      { "field": "nutrition.calories", "type": "single" },
      { "field": "nutrition.protein", "type": "single" }
    ]
  }
